# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/b2c_platform_db

# Security
SECRET_KEY=your-super-secret-key-here-change-this-in-production-make-it-long-and-random

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Admin Configuration
ADMIN_EMAIL=admin@yourcompany.com

# Application Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=uploads/

# Playwright Settings
PLAYWRIGHT_HEADLESS=False  # Set to True for production
PLAYWRIGHT_TIMEOUT=30000   # 30 seconds

# Logging
LOG_LEVEL=INFO